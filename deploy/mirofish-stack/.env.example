# ZeroClaw + MiroFish stack — operator-supplied secrets.
#
# Copy this file to .env and fill in the values BEFORE
# `docker compose up -d`. Never commit .env to git — the
# .gitignore at repo root already covers it.
#
# Required for first boot:
#   - OPENROUTER_API_KEY     (MiroFish backend + Zep embedder)
#
# Strongly recommended:
#   - ZEROCLAW_AUTO_PAIR_TOKEN   (skip pairing flow for headless deploys)
#   - GRAFANA_ADMIN_PASSWORD     (default 'admin-change-me' is unsafe)
#   - POSTGRES_ZEP_PASSWORD      (Zep postgres user)
#   - ZEP_AUTH_SECRET            (Zep API auth)
#   - ZEP_API_KEY                (passed to MiroFish backend; matches ZEP_AUTH_SECRET)
#
# Optional:
#   - MIROFISH_LLM_MODEL     (default: deepseek/deepseek-chat — cheap + capable)

# ── Required: upstream LLM via OpenRouter ──────────────────────
# Get one at https://openrouter.ai/settings/keys
# Load up at least $20 of credit so you can finish a single
# 500-agent simulation without rate-limiting.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional: which model MiroFish uses for the agent simulation.
# deepseek-chat is the cheap-but-capable default. Bump to
# anthropic/claude-3.5-sonnet only after smoke-test validates
# persona-mix fit on the cheaper model.
MIROFISH_LLM_MODEL=deepseek/deepseek-chat

# ── Recommended: pairing bypass for headless / cloud deploys ───
# Generate with: openssl rand -hex 32
# When set, the ZeroClaw gateway accepts this exact bearer token
# without going through the pairing flow. Use ONLY when the host
# is private (Hetzner private network, VPN, or 127.0.0.1).
ZEROCLAW_AUTO_PAIR_TOKEN=

# ── Recommended: Grafana admin ─────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change-this-please

# ── Recommended: Zep credentials ───────────────────────────────
# Generate with: openssl rand -hex 16 (each)
# ZEP_API_KEY is what MiroFish backend sends as a header;
# ZEP_AUTH_SECRET is what Zep validates incoming requests against.
# They MUST match.
POSTGRES_ZEP_PASSWORD=replace-zep-pg-password
ZEP_AUTH_SECRET=replace-zep-secret-32-chars
ZEP_API_KEY=replace-zep-secret-32-chars
